<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dashboard | Bosco English Academy</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      color: #243247;
    }

    header {
      background: #123b70;
      color: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    header h2 {
      margin: 5px 0;
      color: white;
    }

    main {
      max-width: 1100px;
      margin: 40px auto;
      padding: 20px;
    }

    .welcome,
    .course,
    .profile,
    .tutor {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 3px 12px #00000010;
    }

    .profile {
      text-align: center;
      padding: 30px;
    }

    .profile img {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      object-fit: cover;
      border: 4px solid #1769aa;
      display: block;
      margin: 0 auto;
    }

    h1, h2, h3 {
      color: #123b70;
    }

    .courses {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    button {
      background: #1769aa;
      color: white;
      border: 0;
      padding: 12px 18px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 15px;
    }

    button:hover {
      background: #123b70;
    }

    button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .logout {
      background: white;
      color: #123b70;
    }

    .tutor {
      border-top: 5px solid #1769aa;
    }

    .tutor-header {
      text-align: center;
    }

    .tutor-header img {
      width: 85px;
      height: 85px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #1769aa;
    }

    .chat-messages {
      background: #f3f6fb;
      padding: 15px;
      border-radius: 10px;
      min-height: 150px;
      max-height: 500px;
      overflow-y: auto;
      margin: 20px 0;
    }

    .chat-message {
      padding: 15px;
      margin: 12px 0;
      border-radius: 8px;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }

    .student-message {
      background: #dcecff;
      white-space: pre-wrap;
    }

    .tutor-message {
      background: white;
      border-left: 4px solid #1769aa;
    }

    .tutor-message p {
      margin: 10px 0;
    }

    .tutor-message > div > *:first-child {
      margin-top: 0;
    }

    .tutor-message > div > *:last-child {
      margin-bottom: 0;
    }

    .tutor-message h1,
    .tutor-message h2,
    .tutor-message h3,
    .tutor-message h4 {
      margin-top: 18px;
      margin-bottom: 8px;
    }

    .tutor-message ul,
    .tutor-message ol {
      padding-left: 25px;
    }

    .tutor-message li {
      margin-bottom: 7px;
    }

    .tutor-message table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
      display: block;
      overflow-x: auto;
    }

    .tutor-message th,
    .tutor-message td {
      border: 1px solid #d5deea;
      padding: 10px;
      text-align: left;
    }

    .tutor-message th {
      background: #eaf2fc;
    }

    .tutor-message blockquote {
      border-left: 3px solid #1769aa;
      margin-left: 0;
      padding-left: 12px;
      color: #52657b;
    }

    .tutor-message code {
      background: #eef2f7;
      padding: 2px 5px;
      border-radius: 4px;
    }

    .tutor-message pre {
      background: #eef2f7;
      padding: 12px;
      border-radius: 6px;
      overflow-x: auto;
    }

    #studentQuestion {
      width: 100%;
      box-sizing: border-box;
      padding: 13px;
      border: 1px solid #ccc;
      border-radius: 7px;
      font-family: Arial, sans-serif;
      font-size: 15px;
      resize: vertical;
    }

    #tutorStatus {
      color: #1769aa;
      font-weight: bold;
    }

    footer {
      text-align: center;
      padding: 20px;
      color: #667;
    }

    @media (max-width: 600px) {
      header {
        padding: 15px;
      }

      main {
        margin: 15px auto;
        padding: 12px;
      }

      .welcome,
      .course,
      .profile,
      .tutor {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Bosco English Academy</h2>
  <button class="logout" id="logoutButton">Log out</button>
</header>

<main>

  <section class="profile">

    <h2>Bosco English Academy</h2>

    <img
      src="Jean-Bosco-founder.png.png"
      alt="Jean Bosco Munezero"
    >

    <h2 id="studentName">Loading...</h2>

  </section>

  <section class="welcome">

    <h1>Welcome to Your Dashboard!</h1>

    <p>Building Confidence in English.</p>

    <p>Choose a learning area and continue improving your English.</p>

  </section>

  <h2>My Learning Areas</h2>

  <section class="courses">

    <div class="course">
      <h3>🎧 Listening</h3>
      <p>Improve your understanding of spoken English.</p>
      <button onclick="openCourse('Listening')">Explore lessons</button>
    </div>

    <div class="course">
      <h3>💬 Speaking</h3>
      <p>Develop confidence in English communication.</p>
      <button onclick="openCourse('Speaking')">Explore lessons</button>
    </div>

    <div class="course">
      <h3>📖 Reading</h3>
      <p>Improve reading fluency and comprehension.</p>
      <button onclick="openCourse('Reading')">Explore lessons</button>
    </div>

    <div class="course">
      <h3>✍️ Writing</h3>
      <p>Learn to write clear English sentences.</p>
      <button onclick="openCourse('Writing')">Explore lessons</button>
    </div>

    <div class="course">
      <h3>🔤 Grammar</h3>
      <p>Understand and practise English grammar.</p>
      <button onclick="openCourse('Grammar')">Explore lessons</button>
    </div>

    <div class="course">
      <h3>🧠 Vocabulary</h3>
      <p>Build your English vocabulary.</p>
      <button onclick="openCourse('Vocabulary')">Explore lessons</button>
    </div>

  </section>

  <!-- AUTOMATIC AI TUTOR -->

  <section class="tutor" id="aiTutor">

    <div class="tutor-header">

      <img
        src="Jean-Bosco-founder.png.png"
        alt="Jean Bosco AI Tutor"
      >

      <h2>Jean Bosco AI Tutor</h2>

      <p>Your personal English learning assistant at Bosco English Academy.</p>

      <p>Ask questions, practise English and improve your confidence.</p>

    </div>

    <div class="chat-messages" id="chatMessages">

      <div class="chat-message tutor-message">

        <strong>Jean Bosco AI Tutor:</strong>

        <p>Hello! Welcome to Bosco English Academy.</p>

        <p>I am your AI learning assistant. You can ask me questions about grammar, vocabulary, pronunciation, speaking, reading, writing and other educational subjects.</p>

        <p>What would you like to learn today?</p>

      </div>

    </div>

    <textarea
      id="studentQuestion"
      placeholder="Type your question here..."
      rows="3"
    ></textarea>

    <br><br>

    <button id="sendQuestion">Send Question</button>

    <p id="tutorStatus"></p>

  </section>

</main>

<footer>

  <p>© 2026 Bosco English Academy | Building Confidence in English</p>

  <p>Founded by Jean Bosco Munezero</p>

</footer>


<!-- REQUIRED LIBRARIES -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>


<script>

// SUPABASE CONNECTION

const supabaseClient = window.supabase.createClient(
  'https://arnlcdpncwuruacaqjko.supabase.co',
  'sb_publishable_G8P0TF0s0GD-vTcvaghAOg_HtIzVxp-'
);


// CHECK STUDENT LOGIN

async function start() {

  const { data, error } = await supabaseClient.auth.getUser();

  if (error || !data.user) {
    window.location.href = 'index.html';
    return;
  }

  const user = data.user;
  const metadata = user.user_metadata || {};

  const name =
    metadata.full_name ||
    metadata.name ||
    user.email ||
    'Student';

  document.getElementById('studentName').textContent = name;

}

start();


// LOG OUT

document.getElementById('logoutButton').onclick = async () => {

  const { error } = await supabaseClient.auth.signOut();

  if (error) {
    alert(error.message);
    return;
  }

  window.location.href = 'index.html';

};


// OPEN COURSES

function openCourse(course) {

  window.location.href =
    'courses.html?course=' + encodeURIComponent(course);

}


// AI TUTOR ELEMENTS

const sendButton = document.getElementById('sendQuestion');

const questionBox = document.getElementById('studentQuestion');

const chatMessages = document.getElementById('chatMessages');

const tutorStatus = document.getElementById('tutorStatus');


// DISPLAY CHAT MESSAGES

function addMessage(sender, message, className) {

  const messageDiv = document.createElement('div');

  messageDiv.className = 'chat-message ' + className;

  const heading = document.createElement('strong');

  heading.textContent = sender + ':';

  messageDiv.appendChild(heading);

  if (className === 'tutor-message') {

    const answerDiv = document.createElement('div');

    const formattedHTML = marked.parse(String(message || ''));

    answerDiv.innerHTML = DOMPurify.sanitize(formattedHTML);

    messageDiv.appendChild(answerDiv);

  } else {

    const paragraph = document.createElement('p');

    paragraph.textContent = message;

    messageDiv.appendChild(paragraph);

  }

  chatMessages.appendChild(messageDiv);

  chatMessages.scrollTop = chatMessages.scrollHeight;

}


// SEND STUDENT QUESTION TO AI

async function sendQuestion() {

  const message = questionBox.value.trim();

  if (!message) {

    tutorStatus.textContent = 'Please enter your question.';

    return;

  }

  if (message.length > 4000) {

    tutorStatus.textContent = 'Your question must not exceed 4,000 characters.';

    return;

  }

  sendButton.disabled = true;

  tutorStatus.textContent = 'Jean Bosco AI Tutor is thinking...';

  addMessage('You', message, 'student-message');

  questionBox.value = '';

  try {

    const { data, error } =
      await supabaseClient.functions.invoke(
        'academy-assistant',
        {
          body: {
            message: message
          }
        }
      );

    if (error) {
      throw error;
    }

    if (!data || !data.answer) {
      throw new Error('The tutor did not return an answer.');
    }

    addMessage(
      'Jean Bosco AI Tutor',
      data.answer,
      'tutor-message'
    );

    tutorStatus.textContent = 'Excellent! You can ask another question.';

  } catch (error) {

    console.error('AI Tutor error:', error);

    addMessage(
      'Jean Bosco AI Tutor',
      'I am sorry. I could not answer your question right now. Please try again.',
      'tutor-message'
    );

    tutorStatus.textContent =
      'There was a problem connecting to the tutor. Please try again.';

  } finally {

    sendButton.disabled = false;

  }

}


// SEND BUTTON

sendButton.addEventListener('click', sendQuestion);


// CTRL + ENTER TO SEND

questionBox.addEventListener('keydown', function(event) {

  if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {

    event.preventDefault();

    sendQuestion();

  }

});

</script>

</body>
</html>
