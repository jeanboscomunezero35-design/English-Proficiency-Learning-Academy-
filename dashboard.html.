<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  Bosco English Academy

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      color: #243247;
    }

    header {
      background: #123b70;
      color: white;
      padding: 22px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    header h2 {
      margin: 0;
      font-size: 20px;
    }

    .logout {
      background: white;
      color: #123b70;
      border: none;
      padding: 10px 18px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }

    main {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .welcome {
      background: white;
      padding: 30px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 3px 12px #00000010;
    }

    .welcome h1 {
      color: #123b70;
    }

    .courses {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .course {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 3px 12px #00000010;
    }

    .course h3 {
      color: #123b70;
    }

    /* DIRECT COURSE LINKS */

    .course-link {
      display: inline-block;
      background: #1769aa;
      color: white;
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
    }

    .course-link:hover {
      background: #123b70;
    }

    footer {
      text-align: center;
      padding: 30px;
      color: #667085;
    }

    .ai-assistant {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-top: 35px;
      box-shadow: 0 3px 12px #00000010;
    }

    .ai-assistant h2 {
      color: #123b70;
    }

    #chatMessages {
      background: #f3f6fb;
      padding: 15px;
      border-radius: 8px;
      min-height: 120px;
      max-height: 350px;
      overflow-y: auto;
      margin-bottom: 15px;
    }

   .chat-message {
  padding: 15px;
  margin: 12px 0;
  border-radius: 8px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.student-message {
  white-space: pre-wrap;
}

.ai-message p {
  margin: 10px 0;
}

.ai-message h1,
.ai-message h2,
.ai-message h3 {
  color: #123b70;
  margin-top: 18px;
  margin-bottom: 8px;
}

.ai-message ul,
.ai-message ol {
  padding-left: 25px;
}

.ai-message li {
  margin-bottom: 7px;
}
    .student-message {
      background: #dcecff;
      text-align: right;
    }

    .ai-message {
      background: white;
      border: 1px solid #ddd;
    }

    .chat-input {
      display: flex;
      gap: 10px;
    }

    .chat-input input {
      flex: 1;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      min-width: 0;
    }

    .chat-input button {
      background: #1769aa;
      color: white;
      border: none;
      padding: 12px 18px;
      border-radius: 6px;
      cursor: pointer;
    }

    .chat-input button:hover {
      background: #123b70;
    }

    #sendQuestion:disabled {
      opacity: 0.6;
      cursor: wait;
    }

    @media (max-width: 600px) {
      header {
        gap: 15px;
      }

      .chat-input {
        flex-direction: column;
      }

      .chat-input button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>English Proficiency Learning Academy</h2>
  <button class="logout" id="logoutButton">Log out</button>
</header>

<main>

  <section class="welcome">
    <h1>Welcome, <span id="studentName">Student</span>!</h1>
    <p>Welcome to your English learning dashboard.</p>
    <p>Choose a learning area and continue improving your English.</p>
  </section>

  <h2>My Learning Areas</h2>

  <section class="courses">

    <div class="course">
      <h3>🎧 Listening</h3>
      <p>Improve your understanding of spoken English.</p>
      <a class="course-link" href="courses.html?course=Listening">
        Explore lessons
      </a>
    </div>

    <div class="course">
      <h3>💬 Speaking</h3>
      <p>Develop confidence in English communication.</p>
      <a class="course-link" href="courses.html?course=Speaking">
        Explore lessons
      </a>
    </div>

    <div class="course">
      <h3>📖 Reading</h3>
      <p>Improve reading fluency and comprehension.</p>
      <a class="course-link" href="courses.html?course=Reading">
        Explore lessons
      </a>
    </div>

    <div class="course">
      <h3>✍️ Writing</h3>
      <p>Learn to write clear English sentences and paragraphs.</p>
      <a class="course-link" href="courses.html?course=Writing">
        Explore lessons
      </a>
    </div>

    <div class="course">
      <h3>🔤 Grammar</h3>
      <p>Understand and practise English grammar.</p>
      <a class="course-link" href="courses.html?course=Grammar">
        Explore lessons
      </a>
    </div>

    <div class="course">
      <h3>🧠 Vocabulary</h3>
      <p>Build your English vocabulary.</p>
      <a class="course-link" href="courses.html?course=Vocabulary">
        Explore lessons
      </a>
    </div>

  </section>

  <!-- AI LEARNING ASSISTANT -->

  <section class="ai-assistant">

    <h2>🤖 Academy AI Learning Assistant</h2>

    <p>
      Hello! I am your automatic AI learning assistant.
      Ask me questions about English or other academic subjects.
    </p>

    <div id="chatMessages">
      <div class="chat-message ai-message">
        Hello! How can I help you learn today?
      </div>
    </div>

    <div class="chat-input">

      <input
        type="text"
        id="studentQuestion"
        placeholder="Type your question here..."
      >

      <button id="sendQuestion">Send</button>

    </div>

  </section>

</main>

<footer>
  © 2026 English Proficiency Learning Academy
</footer>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"></script>
<script>

  // SUPABASE CONNECTION

  const SUPABASE_URL =
    'https://arnlcdpncwuruacaqjko.supabase.co';

  const SUPABASE_PUBLISHABLE_KEY =
    'sb_publishable_G8P0TF0s0GD-vTcvaghAOg_HtIzVxp-';

  const supabaseClient = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY
  );


  // CHECK STUDENT LOGIN

  async function checkStudent() {

    const { data, error } =
      await supabaseClient.auth.getUser();

    if (error || !data.user) {
      window.location.href = 'index.html';
      return;
    }

    document.getElementById('studentName').textContent =
      data.user.user_metadata.full_name || 'Student';

  }

  checkStudent();


  // LOGOUT

  document.getElementById('logoutButton')
    .addEventListener('click', async () => {

      const { error } =
        await supabaseClient.auth.signOut();

      if (error) {
        alert(error.message);
        return;
      }

      window.location.href = 'index.html';

    });


  // AI LEARNING ASSISTANT

  const questionInput =
    document.getElementById('studentQuestion');

  const sendButton =
    document.getElementById('sendQuestion');

  const chatMessages =
    document.getElementById('chatMessages');
function addMessage(message, sender) {

  const messageDiv = document.createElement('div');

  messageDiv.className = 'chat-message ' + sender;

  if (sender === 'ai-message') {

    const safeHTML = DOMPurify.sanitize(
      marked.parse(message)
    );

    messageDiv.innerHTML = safeHTML;

  } else {

    messageDiv.textContent = message;

  }

  chatMessages.appendChild(messageDiv);

  chatMessages.scrollTop = chatMessages.scrollHeight;

}

  // DISPLAY MESSAGES

 

  // SEND STUDENT QUESTION TO AI

  async function sendStudentQuestion() {

    const question = questionInput.value.trim();

    if (!question) return;

    addMessage(question, 'student-message');

    questionInput.value = '';

    sendButton.disabled = true;

    sendButton.textContent = 'Thinking...';

    const waitingMessage =
      document.createElement('div');

    waitingMessage.className =
      'chat-message ai-message';

    waitingMessage.textContent =
      'The assistant is preparing your answer...';

    chatMessages.appendChild(waitingMessage);

    try {

      const { data, error } =
        await supabaseClient.functions.invoke(
          'academy-assistant',
          {
            body: {
              message: question
            }
          }
        );

      waitingMessage.remove();

      if (error) {
        throw error;
      }

      if (data.error) {
        throw new Error(data.error);
      }

      addMessage(data.answer, 'ai-message');

    } catch (error) {

      waitingMessage.remove();

      addMessage(
        'Sorry, I could not answer right now. Please try again.',
        'ai-message'
      );

      console.error('AI Assistant error:', error);

    } finally {

      sendButton.disabled = false;

      sendButton.textContent = 'Send';

      questionInput.focus();

    }

  }


  // SEND BUTTON EVENT

  sendButton.addEventListener(
    'click',
    sendStudentQuestion
  );


  // PRESS ENTER TO SEND

  questionInput.addEventListener('keydown', function(event) {

    if (event.key === 'Enter') {
      sendStudentQuestion();
    }

  });

</script>

</body>
</html>
