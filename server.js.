require("dotenv").config();

const express = require("express");
const cors = require("cors");
const helmet = require("helmet");

const app = express();

const PORT = process.env.PORT || 3000;
const HOST = process.env.HOST || "127.0.0.1";

const allowedOrigins = (
  process.env.BEA_ALLOWED_ORIGINS ||
  "http://localhost:3000"
)
  .split(",")
  .map(origin => origin.trim());

app.use(helmet());

app.use(cors({
  origin: function (origin, callback) {
    if (!origin || allowedOrigins.includes(origin)) {
      return callback(null, true);
    }

    return callback(new Error("Origin not allowed"));
  }
}));

app.use(express.json({ limit: "10kb" }));

// Main information endpoint
app.get("/", (req, res) => {
  res.json({
    name: "BEA Camera Bridge",
    academy: "Bosco English Academy",
    status: "Running",
    version: "1.0.0"
  });
});

// Health check
app.get("/health", (req, res) => {
  res.json({
    status: "healthy",
    service: "BEA Camera Bridge",
    cameraStreaming: "Not yet configured"
  });
});

// Bridge capabilities
app.get("/api/v1/bridge/info", (req, res) => {
  res.json({
    service: "BEA Universal Camera Bridge",
    supportedTargets: [
      "Compatible ONVIF cameras",
      "Compatible RTSP cameras",
      "WebRTC streaming cameras",
      "Compatible 4G and 5G network cameras"
    ],
    features: {
      cameraRegistration: "Planned",
      cameraDiscovery: "Planned",
      videoStreaming: "Not yet implemented",
      schoolAccounts: "Planned"
    }
  });
});

// Error handler
app.use((err, req, res, next) => {
  console.error("BEA Bridge error:", err.message);

  res.status(500).json({
    error: "BEA Bridge encountered an internal error."
  });
});

// Start server
app.listen(PORT, HOST, () => {
  console.log("--------------------------------");
  console.log("BEA CAMERA BRIDGE");
  console.log("Server is running.");
  console.log(`Address: http://${HOST}:${PORT}`);
  console.log("--------------------------------");
});

